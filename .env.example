# ==============================================================================
# SAMAUR MART - Production Environment Variables Example
# Copy this file to .env and configure appropriate values for your deployment environment.
# ==============================================================================

# 1. Platform Server & API
PORT=5000
FLASK_ENV=production
SECRET_KEY=generate_a_secure_random_64_character_hex_key_here
BASE_URL=https://rama-store-3u49.onrender.com
CORS_ORIGINS=https://rama-store-1.onrender.com,http://localhost:3000,http://127.0.0.1:5000

# 2. Authoritative Database Configuration
DATABASE_PATH=rama_store.db
DATABASE_URL=sqlite:///rama_store.db
SQLITE_TIMEOUT=30

# 3. Authentication & Security
SESSION_COOKIE_NAME=rama_store_session
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_SECONDS=2592000

# 4. Production SMS & Email OTP Gateways
# The system supports multi-provider OTP dispatch with automatic fallback.
# Configure at least ONE of the providers below for real OTP SMS / Email delivery:

# --- Option A: Fast2SMS (Recommended for India - Quickest Setup) ---
# Sign up at https://www.fast2sms.com and get your API Authorization Key:
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# --- Option B: Twilio (Global SMS Gateway) ---
# Sign up at https://www.twilio.com:
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# --- Option C: MSG91 (Indian DLT Registered Gateway) ---
# Sign up at https://msg91.com:
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_dlt_template_id_here

# --- Option D: SMTP Email Delivery (for Email OTPs & notifications) ---
# Works with Gmail (App Password), Outlook, Amazon SES, or SendGrid:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_store_email@gmail.com
SMTP_PASSWORD=your_gmail_16_character_app_password
SMTP_FROM=support@ramastore.com

# Controls whether OTP code is also returned in JSON response during dev/testing (true/false)
# In production, set to false once your SMS provider is live.
ENABLE_DEBUG_OTP=true

# 5. Mobile App Firebase Integration
# Mobile app uses Firebase Phone Auth configured via firebase_options.dart / google-services.json

# 6. Payment Gateway (Sandbox / Live Razorpay / Stripe)
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id_here
RAZORPAY_KEY_SECRET=your_actual_key_secret_here

# 7. Default Admin Provisioning
ADMIN_DEFAULT_EMAIL=admin@ramastore.com
ADMIN_ROLE=super_admin
DEFAULT_ADMIN_PASSWORD=Admin@12345
